APP_NAME=Titiktemu.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=titiktemu_db
DB_USERNAME=titiktemu_dev
DB_PASSWORD=

# ==========================================
# E2E TESTING
# ==========================================
E2E_APP_PORT=8000
E2E_APP_URL=http://127.0.0.1:8000

E2E_DB_CONNECTION=pgsql
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=5432
E2E_DB_DATABASE=titiktemu_testing
E2E_DB_USERNAME=titiktemu_dev
E2E_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=300
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==========================================
# MAIL — isi dengan kredensial Anda
# ==========================================
BREVO_API_KEY=
MAIL_MAILER=brevo
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_RECIPIENT_EMAIL=

# ==========================================
# OAUTH — isi dengan kredensial Anda
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ==========================================
# RATE LIMITING
# ==========================================
AUTH_THROTTLE_LOGIN_MAX=5
AUTH_THROTTLE_REGISTER_MAX=3
AUTH_THROTTLE_FORGOT_MAX=3
AUTH_THROTTLE_RESET_MAX=5
AUTH_PASSWORD_RESET_THROTTLE=60

VITE_APP_NAME="${APP_NAME}"